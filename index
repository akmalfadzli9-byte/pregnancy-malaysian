  function renderFetalWeightChart() {
    const container = document.getElementById('fetalWeightChart');
    if(!container) return;
    const weeks = [8,12,16,20,24,28,32,36,40];
    const points = weeks.map(w => {
      const d = fetalData.find(f => f.week === w);
      const grams = d ? parseFloat(d.weight.replace(/[^0-9.]/g,'')) * 1000 || 0 : 0;
      return {week:w, grams};
    });
    const maxG = Math.max(...points.map(p=>p.grams), 100);
    container.innerHTML = points.map(p => {
      const h = Math.max(6, (p.grams/maxG)*100);
      return `<div class="chart-bar-wrapper"><div class="chart-value">${p.grams>=1000?(p.grams/1000).toFixed(1)+'kg':p.grams+'g'}</div><div class="chart-bar pink-bar" style="height:${h}px;"></div><div class="chart-label">Mg ${p.week}</div></div>`;
    }).join('');
  }

  function renderBabyWeightChart() {
    const container = document.getElementById('babyWeightChart');
    if(!container) return;
    const months = [0,1,2,3,4,5,6,8,10,12];
    const points = months.map(m => {
      const d = postnatalData.find(p => p.month === m);
      return d ? {month:m, wtM:d.wtM, wtF:d.wtF} : {month:m, wtM:0, wtF:0};
    });
    const maxW = Math.max(...points.flatMap(p=>[p.wtM, p.wtF]), 1);
    container.innerHTML = points.map(p => {
      const hM = Math.max(6, (p.wtM/maxW)*100);
      const hF = Math.max(6, (p.wtF/maxW)*100);
      return `<div class="chart-bar-wrapper"><div class="chart-value" style="font-size:0.65rem;">♂${p.wtM.toFixed(1)} ♀${p.wtF.toFixed(1)}</div><div style="display:flex;gap:3px;"><div class="chart-bar purple-bar" style="height:${hM}px;width:16px;" title="Lelaki"></div><div class="chart-bar pink-bar" style="height:${hF}px;width:16px;" title="Perempuan"></div></div><div class="chart-label">${p.month===0?'BBL':p.month+'bln'}</div></div>`;
    }).join('');
  }

  function populatePostnatalTable() {
    const tbody = document.querySelector('#postnatalTable tbody');
    if(!tbody) return;
    tbody.innerHTML = postnatalData.map(d => `<tr><td><strong>${d.month===0?'Baru Lahir':d.month}</strong></td><td>${d.wtM.toFixed(1)}</td><td>${d.wtF.toFixed(1)}</td><td>${d.lenM.toFixed(1)}</td><td>${d.lenF.toFixed(1)}</td><td>${d.hcM.toFixed(1)}</td><td>${d.hcF.toFixed(1)}</td></tr>`).join('');
  }

  // ========== TAB SWITCHING ==========
  function switchTab(tabName) {
    document.querySelectorAll('.view-container').forEach(v => v.classList.remove('active'));
    document.querySelectorAll('.main-tab-btn').forEach(b => b.classList.remove('active'));
    const targetView = document.getElementById('view' + tabName.charAt(0).toUpperCase() + tabName.slice(1));
    const targetBtn = document.querySelector(`.main-tab-btn[data-tab="${tabName}"]`);
    if (targetView) targetView.classList.add('active');
    if (targetBtn) targetBtn.classList.add('active');

    // Clear timers when leaving dashboard
    if (tabName !== 'dashboard') {
      if (_bfTimerInterval) { clearInterval(_bfTimerInterval); _bfTimerInterval = null; }
      if (_ctTimerInterval) { clearInterval(_ctTimerInterval); _ctTimerInterval = null; }
    }

    if (tabName === 'growth') renderGrowthView();
    if (tabName === 'baby') renderVaccineReminder();
    if (tabName === 'lists') { renderShopList(); renderBagList(); renderBabyHomeList(); renderPantangTips(); renderPantangHabits(); renderUriChecks(); }
    if (tabName === 'dashboard') {
      renderCountdown();
      renderProgressRings();
      renderKickCounter();
      renderContractionTimer();
      renderBreastfeedingTracker();
      renderAppointments();
    }
  }

  // ========== INIT ==========
  function init() {
    // Load stored dates
    const lmpStored = Storage.get('lmp');
    const eddStored = Storage.get('edd');
    const birthStored = Storage.get('birthDate');
    if (lmpStored) currentEDD = DateUtils.addDays(new Date(lmpStored), 280);
    else if (eddStored) {
      currentEDD = new Date(eddStored);
      Storage.set('lmp', DateUtils.fmt(DateUtils.addDays(currentEDD, -280)));
    } else {
      currentEDD = new Date('2026-07-18');
      Storage.set('edd','2026-07-18'); Storage.set('lmp','2025-10-11');
    }
    currentBirthDate = birthStored ? new Date(birthStored) : null;
    document.getElementById('lmpInput').value = Storage.get('lmp')||'';
    document.getElementById('eddInput').value = DateUtils.fmt(currentEDD);
    if(currentBirthDate && !isNaN(currentBirthDate.getTime())) document.getElementById('birthInput').value = DateUtils.fmt(currentBirthDate);

    // Date input events
    document.getElementById('lmpInput').addEventListener('change', function(){
      let val = this.value;
      if(val){
        let lmp = new Date(val);
        if(!isNaN(lmp.getTime())){
          currentEDD = DateUtils.addDays(lmp, 280);
          Storage.set('lmp',val); Storage.set('edd',DateUtils.fmt(currentEDD));
          document.getElementById('eddInput').value = DateUtils.fmt(currentEDD);
          switchTab('dashboard'); renderVaccineReminder();
        }
      }
    });
    document.getElementById('eddInput').addEventListener('change', function(){
      let val = this.value;
      currentEDD = DateUtils.safeDate(val, '2026-07-18');
      Storage.set('edd', DateUtils.fmt(currentEDD));
      const lmp = DateUtils.addDays(currentEDD, -280);
      Storage.set('lmp', DateUtils.fmt(lmp));
      document.getElementById('lmpInput').value = DateUtils.fmt(lmp);
      switchTab('dashboard'); renderVaccineReminder();
    });
    document.getElementById('birthInput').addEventListener('change', function(){
      let val = this.value;
      if(val){
        currentBirthDate = new Date(val);
        if(isNaN(currentBirthDate.getTime())) currentBirthDate = null;
      } else currentBirthDate = null;
      Storage.set('birthDate', currentBirthDate ? DateUtils.fmt(currentBirthDate) : null);
      switchTab('dashboard'); renderVaccineReminder();
    });

    // Global click handlers
    document.body.addEventListener('click', function(e){
      if(e.target.id==='exportPdfBtn') { e.preventDefault(); exportPDF(); }
      if(e.target.id==='addItemBtn') { /* shop add logic */ }
      if(e.target.classList.contains('recipe-btn')) alert(e.target.dataset.recipe);
      if(e.target.classList.contains('grocery-btn')) { /* modal */ }
    });
    // Tab buttons
    document.querySelectorAll('.main-tab-btn').forEach(btn => {
      btn.addEventListener('click', () => switchTab(btn.dataset.tab));
    });

    // Growth slider events
    document.getElementById('growthWeekSlider').addEventListener('input', function(){
      growthWeek = parseInt(this.value);
      document.getElementById('growthWeekDisplay').textContent = `Minggu ${growthWeek}`;
      renderFetalInfo();
      highlightTableRow();
    });
    document.getElementById('growthPrevBtn').addEventListener('click', ()=> changeGrowthWeek(-1));
    document.getElementById('growthNextBtn').addEventListener('click', ()=> changeGrowthWeek(1));

    // Accordions
    document.querySelectorAll('.accordion-header').forEach(h => {
      h.addEventListener('click', function(){
        const body = this.nextElementSibling;
        const isOpen = body.classList.contains('open');
        document.querySelectorAll('.accordion-body').forEach(b => b.classList.remove('open'));
        document.querySelectorAll('.accordion-header .arrow').forEach(a => a.textContent = '▼');
        if (!isOpen) {
          body.classList.add('open');
          this.querySelector('.arrow').textContent = '▲';
        }
      });
    });

    // Initial render
    switchTab('dashboard');
    renderMealGrid();
    renderKkmContent();
    // Pre-populate growth data
    populateFetalTable();
    populatePostnatalTable();
    renderFetalWeightChart();
    renderBabyWeightChart();

    if(window.Notification && Notification.permission === 'default') Notification.requestPermission();
  }

  function exportPDF() {
    const w = window.open('','_blank','width=800,height=600');
    w.document.write(`<html><head><meta charset="utf-8"><title>Laporan BungaTracker</title></head><body><h2>🌸 Laporan BungaTracker</h2><p>${new Date().toLocaleDateString()}</p><pre>${JSON.stringify({kick:Storage.get('kickData'),appt:Storage.get('appointments')},null,2)}</pre></body></html>`);
    w.document.close(); setTimeout(()=>w.print(),400);
  }

  window.addEventListener('beforeunload', ()=>{
    if(_bfTimerInterval) clearInterval(_bfTimerInterval);
    if(_ctTimerInterval) clearInterval(_ctTimerInterval);
  });

  init();
})();
</script>
</body>
</html>