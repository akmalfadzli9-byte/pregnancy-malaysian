  function renderCountdown() {
    const card = document.getElementById('countdownCard');
    if (!currentEDD || isNaN(currentEDD.getTime())) { card.innerHTML = '<p style="color:#999;">Sila masukkan LMP atau EDD</p>'; return; }
    const today = DateUtils.today(); const due = new Date(currentEDD); due.setHours(0,0,0,0);
    const diffDays = DateUtils.daysBetween(today, due);
    const gestDays = CONST.PREG - diffDays;
    const gestWeeks = Math.floor(gestDays/7);
    const hasBirth = currentBirthDate && !isNaN(currentBirthDate.getTime());
    let heading='', sub='', trimester='', trClass='';
    if (hasBirth) {
      const birth = new Date(currentBirthDate); birth.setHours(0,0,0,0);
      const postDays = DateUtils.daysBetween(birth, today);
      heading = `${Math.max(0, postDays)}`;
      sub = 'hari selepas bersalin'; trimester='Postpartum'; trClass='trimester-3';
    } else if (diffDays > 0) {
      heading = `${diffDays}`;
      sub = 'hari lagi sehingga due';
      if (gestWeeks < 14) { trimester = 'Trimester Pertama (0-13 minggu)'; trClass = 'trimester-1'; }
      else if (gestWeeks < 28) { trimester = 'Trimester Kedua (14-27 minggu)'; trClass = 'trimester-2'; }
      else { trimester = 'Trimester Ketiga (28-40 minggu)'; trClass = 'trimester-3'; }
    } else {
      heading = `${Math.abs(diffDays)}`;
      sub = 'hari melepasi due';
      trimester = 'Lewat – Trimester Ketiga'; trClass = 'trimester-3';
    }
    card.innerHTML = `<div class="countdown-number">${heading}</div><div class="countdown-label">${sub}</div><span class="trimester-badge ${trClass}">${trimester}</span>`;
  }

  function renderProgressRings() {
    if (!currentEDD || isNaN(currentEDD.getTime())) return;
    const today = DateUtils.today(); const due = new Date(currentEDD); due.setHours(0,0,0,0);
    const diff = DateUtils.daysBetween(today, due);
    let pregDays = CONST.PREG - diff; if (pregDays<0) pregDays=0; if (pregDays>CONST.PREG) pregDays=CONST.PREG;
    const pregWeeks = Math.floor(pregDays/7), pregRem=pregDays%7;
    let postDays = 0;
    if (currentBirthDate && !isNaN(currentBirthDate.getTime())) {
      const birth = new Date(currentBirthDate); birth.setHours(0,0,0,0);
      postDays = DateUtils.daysBetween(birth, today);
      if (postDays<0) postDays=0; if (postDays>CONST.POST) postDays=CONST.POST;
    }
    const pregOffset = CONST.CIRC - (pregDays/CONST.PREG)*CONST.CIRC;
    const postOffset = CONST.CIRC - (postDays/CONST.POST)*CONST.CIRC;
    document.getElementById('progressRings').innerHTML = `
      <div class="progress-card">
        <div class="ring-container"><svg class="ring" viewBox="0 0 120 120"><circle class="bg-circle" cx="60" cy="60" r="52"/><circle class="progress-circle" cx="60" cy="60" r="52" stroke-dasharray="326.73" stroke-dashoffset="${pregOffset}"/></svg><div class="ring-text"><span class="days">${pregDays}</span><span class="label">hari hamil</span></div></div>
        <span class="week-badge">Minggu ${pregWeeks}+${pregRem}</span><span style="font-size:0.7rem;">🤰</span>
      </div>
      <div class="progress-card">
        <div class="ring-container"><svg class="ring" viewBox="0 0 120 120"><circle class="bg-circle" cx="60" cy="60" r="52"/><circle class="progress-circle postpartum-circle" cx="60" cy="60" r="52" stroke-dasharray="326.73" stroke-dashoffset="${postOffset}"/></svg><div class="ring-text"><span class="days">${postDays}</span><span class="label">hari pantang</span></div></div>
        <span class="week-badge">Hari ${postDays}</span><span style="font-size:0.7rem;">👶</span>
      </div>`;
  }

  function renderKickCounter() {
    const wrapper = document.getElementById('kickWrapper');
    if (!currentEDD || isNaN(currentEDD.getTime())) { wrapper.style.display='none'; return; }
    const today = DateUtils.today(); const due = new Date(currentEDD); due.setHours(0,0,0,0);
    const gestDays = CONST.PREG - DateUtils.daysBetween(today, due);
    const gestWeeks = Math.floor(gestDays/7);
    if (gestWeeks < CONST.KICK_START || gestDays <= 0 || DateUtils.daysBetween(today, due) < 0) { wrapper.style.display='none'; return; }
    wrapper.style.display='block';
    const kickData = Storage.get('kickData') || {};
    const todayStr = DateUtils.fmt(today);
    const count = kickData[todayStr]?.count || 0;
    wrapper.innerHTML = `<div class="kick-section"><div class="kick-header"><div><span class="kick-count" id="kickCount">${count}</span><span class="kick-target"> / 10 hari ini</span></div><div style="display:flex;gap:0.4rem;align-items:center;"><button class="kick-btn-secondary" id="kickMinusBtn" ${count===0?'disabled':''}>−</button><button class="kick-btn" id="kickBtn" ${count>=CONST.KICK_TARGET?'disabled':''}>+</button></div></div><div class="calendar" id="kickCal"></div><p style="font-size:0.65rem;text-align:center;margin-top:0.5rem;">🌸 KKM: Catat pergerakan janin setiap hari mulai 28 minggu</p></div>`;
    renderKickCalendar();
    document.getElementById('kickBtn').addEventListener('click', ()=>{
      let data = Storage.get('kickData')||{};
      let entry = data[todayStr]||{count:0};
      if(entry.count < CONST.KICK_TARGET) {
        entry.count++; data[todayStr]=entry; Storage.set('kickData',data);
        document.getElementById('kickCount').textContent = entry.count;
        document.getElementById('kickBtn').disabled = entry.count >= CONST.KICK_TARGET;
        document.getElementById('kickMinusBtn').disabled = entry.count === 0;
        renderKickCalendar();
        backupToSheet('saveKick', { date: todayStr, count: entry.count });
      }
    });
    document.getElementById('kickMinusBtn').addEventListener('click', ()=>{
      let data = Storage.get('kickData')||{};
      let entry = data[todayStr]||{count:0};
      if(entry.count > 0) {
        entry.count--; data[todayStr]=entry; Storage.set('kickData',data);
        document.getElementById('kickCount').textContent = entry.count;
        document.getElementById('kickBtn').disabled = entry.count >= CONST.KICK_TARGET;
