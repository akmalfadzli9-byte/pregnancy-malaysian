<!DOCTYPE html>
<html lang="ms">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>BungaTracker · Kehamilan & 1000 Hari Pantang | KKM</title>
  <meta name="theme-color" content="#b45f7a">
  <meta name="description" content="Aplikasi penjagaan kehamilan & pantang berpandukan KKM">
  <link rel="manifest" id="manifestLink">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="BungaTracker">
  <link rel="apple-touch-icon" href="data:image/svg+xml;base64,">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Alice&family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    :root {
      --primary: #b45f7a; --primary-soft: #e894a9; --primary-light: #fce4ec; --primary-bg: #fff6f9;
      --accent: #c9a1b8; --green: #00b894; --amber: #f4c542; --text: #3e3444; --text-light: #a88b99;
      --bg: #fbe9f1; --card-bg: #fffafc; --white: #ffffff; --menu-red: #b03a2e; --menu-red-light: #fdf2f2;
      --shadow: 0 18px 35px rgba(213,154,178,0.15); --radius: 2.2rem; --radius-sm: 1.2rem;
      --transition: 0.25s ease; --safe-bottom: env(safe-area-inset-bottom, 12px);
      --growth-primary: #b45f7a; --growth-soft: #e894a9; --growth-light: #fce4ec;
    }
    * { margin:0; padding:0; box-sizing:border-box; }
    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      background: linear-gradient(145deg, #fbe9f1 0%, #f8f0f5 50%, #fef5f8 100%);
      color: var(--text); min-height: 100vh; padding: 1rem 1rem calc(1rem + var(--safe-bottom));
      display: flex; justify-content: center; align-items: flex-start;
    }
    .app-shell {
      max-width: 960px; width: 100%; background: var(--card-bg); border-radius: var(--radius);
      box-shadow: var(--shadow); border: 1px solid rgba(255,220,230,0.7); overflow: hidden;
    }
    .app-header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 1.3rem 1.6rem; background: var(--white); border-bottom: 1px solid var(--primary-light);
      flex-wrap: wrap; gap: 0.6rem;
    }
    .logo { display: flex; align-items: center; gap: 0.5rem; }
    .logo i { font-size: 1.8rem; color: var(--primary-soft); filter: drop-shadow(0 4px 6px rgba(232,148,169,0.35)); }
    .logo h1 { font-family: 'Alice', serif; font-size: 1.5rem; color: var(--primary); font-weight: 400; }
    .kkm-badge {
      background: #f7d7e0; padding: 0.35rem 0.9rem; border-radius: 40px;
      font-size: 0.75rem; font-weight: 600; color: #9b4b64; display: flex; align-items: center; gap: 0.3rem;
      border: 1px solid rgba(186,118,140,0.3); white-space: nowrap;
    }
    .main-nav {
      display: flex; gap: 0.35rem; padding: 0.7rem 0.9rem; background: var(--white);
      overflow-x: auto; border-bottom: 1px solid var(--primary-light);
    }
    .main-tab-btn {
      padding: 0.55rem 0.95rem; font-size: 0.75rem; font-weight: 600;
      border: 2px solid transparent; background: #f5f0f3; color: #8b7b85;
      border-radius: 30px; cursor: pointer; transition: var(--transition);
      white-space: nowrap; display: flex; align-items: center; gap: 0.35rem; flex-shrink: 0;
    }
    .main-tab-btn:hover { background: #ede3e8; }
    .main-tab-btn.active { background: var(--primary-light); color: var(--primary); border-color: var(--primary-soft); font-weight: 700; }
    .view-container { display: none; padding: 1rem 1.2rem; animation: fadeSlide 0.35s; }
    .view-container.active { display: block; }
    @keyframes fadeSlide { from { opacity:0; transform:translateY(12px); } to { opacity:1; transform:translateY(0); } }
    .card {
      background: var(--white); border-radius: var(--radius-sm); padding: 1.2rem;
      box-shadow: 0 8px 24px rgba(200,160,175,0.08); border: 1px solid #fce4ec; margin-bottom: 1rem;
    }
    .card h2 {
      font-family: 'Alice', serif; font-size: 1.15rem; color: var(--primary);
      margin: 0 0 0.8rem; display: flex; align-items: center; gap: 0.4rem;
      border-bottom: 1px solid var(--primary-light); padding-bottom: 0.5rem; font-weight: 400;
    }
    .countdown-card {
      text-align: center; background: linear-gradient(135deg, #fff0f5 0%, #ffe9f2 100%);
      border: 2px solid var(--primary-light);
    }
    .countdown-number {
      font-size: 3.5rem; font-weight: 700; color: var(--primary); line-height: 1;
      font-family: 'Alice', serif;
    }
    .countdown-label {
      font-size: 0.9rem; color: var(--text-light); text-transform: uppercase; letter-spacing: 0.5px;
    }
    .trimester-badge {
      display: inline-block; padding: 0.3rem 1rem; border-radius: 20px;
      font-size: 0.75rem; font-weight: 600; margin-top: 0.5rem;
    }
    .trimester-1 { background: #e8f5e9; color: #2e7d32; }
    .trimester-2 { background: #fff3e0; color: #e65100; }
    .trimester-3 { background: #fce4ec; color: #b71c1c; }
    .dual-progress { display: flex; justify-content: space-evenly; gap: 1rem; flex-wrap: wrap; margin-bottom: 0.5rem; }
    .progress-card {
      background: var(--primary-bg); border-radius: 2rem; padding: 1.2rem 0.7rem;
      display: flex; flex-direction: column; align-items: center; border: 1px solid #fce4ec;
      flex: 1 1 140px; transition: transform 0.2s;
    }
    .ring-container { position: relative; width: 95px; height: 95px; margin-bottom: 0.4rem; }
    .ring { transform: rotate(-90deg); width: 100%; height: 100%; }
    .bg-circle { fill: none; stroke: #f3d8e2; stroke-width: 7; }
    .progress-circle { fill: none; stroke: var(--primary-soft); stroke-width: 7; stroke-linecap: round; transition: stroke-dashoffset 0.7s; }
    .postpartum-circle { stroke: var(--accent); }
    .ring-text { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); text-align: center; }
    .ring-text .days { font-size: 1.5rem; font-weight: 700; color: var(--primary); line-height: 1.1; }
    .ring-text .label { font-size: 0.6rem; color: var(--text-light); text-transform: uppercase; letter-spacing: 0.3px; }
    .week-badge { background: #ffecf1; border-radius: 20px; padding: 0.25rem 0.8rem; font-size: 0.7rem; font-weight: 600; color: #c96480; border: 1px solid #ffdbe6; margin-top: 0.2rem; }
    .date-input, .appt-input {
      width: 100%; padding: 0.6rem 1rem; border: 1px solid #f0cdd8; border-radius: 2.5rem;
      font-family: 'Inter', sans-serif; font-size: 0.85rem; color: #4a3340; background: var(--white);
      margin: 0.3rem 0 0.7rem; transition: border 0.2s;
    }
    .date-input:focus, .appt-input:focus { outline: none; border-color: var(--primary-soft); box-shadow: 0 0 0 3px rgba(232,148,169,0.12); }
    .btn-row { display: flex; gap: 0.5rem; flex-wrap: wrap; justify-content: center; margin-top: 0.5rem; }
    .btn {
      padding: 0.6rem 1.1rem; border-radius: 3rem; font-weight: 600; font-size: 0.8rem; cursor: pointer;
      border: 1px solid #f4ced9; transition: var(--transition); display: inline-flex; align-items: center;
      gap: 0.35rem; background: #f9e4ec; color: #7b4a5c; user-select: none;
    }
    .btn:hover { background: #f1cdd9; color: #502c38; }
    .btn.primary-btn { background: var(--primary-soft); color: white; border: none; box-shadow: 0 6px 18px rgba(232,148,169,0.3); }
    .btn.small-btn { padding: 0.4rem 0.8rem; font-size: 0.7rem; }
    .btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
    .kick-section, .contraction-section, .breastfeeding-section {
      background: var(--primary-bg); border-radius: var(--radius-sm); padding: 1.2rem; border: 1px solid #fce4ec; margin-bottom: 1rem;
    }
    .kick-header { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
    .kick-count { font-size: 2.6rem; font-weight: 700; color: var(--primary); line-height: 1; }
    .kick-target { font-size: 0.8rem; color: var(--text-light); }
    .kick-btn {
      background: var(--primary-soft); color: white; border: none; border-radius: 50%; width: 50px; height: 50px;
      font-size: 2rem; display: flex; align-items: center; justify-content: center;
      box-shadow: 0 8px 20px rgba(232,148,169,0.35); cursor: pointer; transition: var(--transition); line-height: 1;
    }
    .kick-btn:hover { background: #d97d95; transform: scale(1.05); }
    .kick-btn-secondary {
      background: #f1cdd9; color: var(--primary); border: none; border-radius: 50%; width: 38px; height: 38px;
      font-size: 1.2rem; display: flex; align-items: center; justify-content: center;
      cursor: pointer; transition: var(--transition);
    }
    .timer-display { font-size: 2.2rem; font-weight: 700; color: var(--primary); text-align: center; margin: 0.5rem 0; }
    .log-list { max-height: 180px; overflow-y: auto; font-size: 0.8rem; }
    .log-item { display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #eacecf; }
    .calendar { margin-top: 1rem; background: var(--white); border-radius: 1.5rem; padding: 0.8rem; border: 1px solid #f0cdd8; }
    .cal-grid { display: grid; grid-template-columns: repeat(7,1fr); text-align: center; gap: 3px; }
    .cal-cell { aspect-ratio: 1/1; display: flex; align-items: center; justify-content: center; border-radius: 50%; font-size: 0.75rem; position: relative; }
    .cal-cell.today { background: #ffe9f0; font-weight: 700; }
    .kick-dot { position: absolute; bottom: 2px; width: 6px; height: 6px; border-radius: 50%; }
    .kick-dot.complete { background: #a6d9a6; } .kick-dot.partial { background: var(--amber); } .kick-dot.missed { background: var(--primary-soft); }
    .timeline { background: #fff0f4; border-radius: 1.6rem; padding: 1rem 0.9rem; border: 1px solid #ffdbe6; max-height: 350px; overflow-y: auto; }
    .timeline-item { display: flex; align-items: flex-start; gap: 0.6rem; margin-bottom: 0.8rem; font-size: 0.82rem; border-bottom: 1px dashed #eacecf; padding-bottom: 0.7rem; }
    .dot { width: 10px; height: 10px; background: var(--primary-soft); border-radius: 50%; margin-top: 0.2rem; flex-shrink: 0; box-shadow: 0 0 0 3px #fbdae3; }
    .vaccine-tag { background: #ffe9f0; padding: 0.1rem 0.5rem; border-radius: 15px; font-size: 0.65rem; font-weight: 700; color: #b15c76; margin-left: 0.3rem; white-space: nowrap; }
    .status-badge { display: inline-block; font-size: 0.62rem; font-weight: 600; padding: 2px 7px; border-radius: 10px; margin-left: 0.3rem; }
    .status-badge.completed { background: #d4edda; color: #155724; }
    .status-badge.upcoming { background: #fff3cd; color: #856404; }
    .side-suggestion { background: #e8f8f5; border-radius: 10px; padding: 0.5rem 0.7rem; font-size: 0.72rem; color: #1e8449; margin: 0.5rem 0; }
    .appt-form { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 0.8rem; }
    .appt-list { list-style: none; max-height: 200px; overflow-y: auto; }
    .appt-item { display: flex; justify-content: space-between; padding: 0.45rem 0; border-bottom: 1px dashed #eacecf; font-size: 0.8rem; }
    .delete-btn { background: none; border: none; color: #c96480; cursor: pointer; font-size: 0.85rem; }
    .list-item { display: flex; align-items: center; justify-content: space-between; padding: 0.45rem 0; font-size: 0.8rem; border-bottom: 1px solid #f5eef1; }
    .list-item.checked span { text-decoration: line-through; color: #b2bec3; }
    .category-header { background: #fdf2f5; border-radius: 12px; padding: 0.45rem 0.7rem; font-weight: 700; color: #8b5b6e; margin: 0.5rem 0 0.2rem; }
    .cat-progress { width: 100%; height: 4px; background: #f3d8e2; border-radius: 2px; margin-top: 0.2rem; }
    .cat-progress-fill { height: 100%; background: var(--primary-soft); border-radius: 2px; transition: width 0.4s; }
    .meal-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px,1fr)); gap: 0.8rem; }
    .meal-card { background: var(--white); border-radius: var(--radius-sm); padding: 1rem; border-top: 6px solid var(--menu-red); position: relative; }
    .meal-card h3 { color: var(--menu-red); font-family: 'Alice', serif; font-size: 1rem; margin-bottom: 0.5rem; }
    .btn-recipe { background: #d35400; color: white; border: none; flex:1; padding: 0.5rem; border-radius: 20px; cursor: pointer; font-size: 0.7rem; font-weight: 600; }
    .btn-grocery { background: #27ae60; color: white; border: none; flex:1; padding: 0.5rem; border-radius: 20px; cursor: pointer; font-size: 0.7rem; font-weight: 600; }
    .modal { display: none; position: fixed; z-index: 100; left:0; top:0; width:100%; height:100%; background: rgba(0,0,0,0.45); animation: fadeIn 0.2s; }
    .modal-content { background: var(--white); margin: 12% auto; padding: 1.3rem; width:90%; max-width:420px; border-radius: 1.6rem; position: relative; }
    .close { position: absolute; top:12px; right:16px; color:#999; font-size:1.5rem; cursor:pointer; }
    .copy-btn { background: #3498db; color: white; border: none; padding: 0.6rem; width: 100%; border-radius: 25px; cursor: pointer; margin-top: 0.8rem; font-weight: 600; }
    .footer-note { text-align: center; font-size: 0.68rem; color: #b2959e; padding: 1rem; border-top: 1px solid #f7dee6; }
    @media (max-width: 420px) { .dual-progress { flex-direction: column; align-items: center; } }

    /* Growth tab styles */
    #viewGrowth .card h3 { font-size: 1.2rem; color: var(--primary); margin-bottom: 0.8rem; display: flex; align-items: center; gap: 0.4rem; }
    #viewGrowth .timeline { background: #fff0f4; }
    .growth-week-selector { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin: 10px 0 16px; }
    .growth-week-selector input[type="range"] { flex:1; min-width:150px; accent-color:var(--primary); }
    .growth-week-selector .week-display { font-weight:700; font-size:1.3rem; color:var(--primary); min-width:90px; text-align:center; background:#fdf6fc; padding:6px 14px; border-radius:20px; border:2px solid var(--primary-soft); }
    .growth-week-selector button { padding:8px 16px; border-radius:20px; border:2px solid var(--primary-soft); background:#fff; cursor:pointer; font-weight:600; color:var(--primary); transition:var(--transition); font-family:'Inter',sans-serif; font-size:0.85rem; }
    .growth-week-selector button:hover { background:#f6f0fa; }
    .stats-row { display: flex; gap: 12px; flex-wrap: wrap; margin: 10px 0; }
    .stat-card { flex:1; min-width:110px; background:var(--card-bg); border-radius:var(--radius-sm); padding:16px 14px; text-align:center; border:2px solid var(--primary-light); transition:var(--transition); }
    .stat-card:hover { border-color:var(--primary-soft); box-shadow:var(--shadow); }
    .stat-card .stat-value { font-size:1.6rem; font-weight:700; color:var(--primary); }
    .stat-card .stat-unit { font-size:0.8rem; color:var(--text-light); }
    .stat-card .stat-label { font-size:0.78rem; font-weight:600; color:var(--text); margin-top:2px; }
    .chart-visual { display: flex; align-items: flex-end; gap: 10px; height: 180px; padding: 10px 0; flex-wrap: wrap; justify-content: center; }
    .chart-bar-wrapper { display: flex; flex-direction: column; align-items: center; gap: 4px; }
    .chart-bar { width: 38px; border-radius: 8px 8px 4px 4px; transition: height 0.6s ease; min-height: 8px; }
    .chart-bar.pink-bar { background: linear-gradient(180deg, #f8b0c8, var(--primary-soft)); }
    .chart-bar.purple-bar { background: linear-gradient(180deg, #c9a0d8, #9b6db5); }
    .chart-label { font-size:0.7rem; font-weight:600; color:var(--text-light); text-align:center; }
    .chart-value { font-size:0.7rem; font-weight:700; color:var(--primary); }
    .progress-container { margin:10px 0; }
    .progress-label { display:flex; justify-content:space-between; font-size:0.85rem; font-weight:600; color:var(--text); margin-bottom:4px; }
    .progress-bar { height:14px; background:#f0e4f5; border-radius:10px; overflow:hidden; }
    .progress-fill { height:100%; border-radius:10px; transition:width 0.6s ease; }
    .progress-fill.pink { background:linear-gradient(90deg, #f08ca8, var(--primary-soft)); }
    .progress-fill.purple { background:linear-gradient(90deg, #b085c4, #7c4d8c); }
    .progress-fill.green { background:linear-gradient(90deg, #7ec89b, #5aad78); }
    .progress-fill.blue { background:linear-gradient(90deg, #7eb8d8, #5a9dbe); }
    .accordion { border-radius:var(--radius-sm); overflow:hidden; margin:8px 0; border:1px solid var(--primary-light); }
    .accordion-header { background:#fdf6fc; padding:14px 18px; cursor:pointer; font-weight:600; color:var(--primary); display:flex; justify-content:space-between; align-items:center; transition:var(--transition); user-select:none; font-size:0.95rem; }
    .accordion-header:hover { background:#f9f0fb; }
    .accordion-header .arrow { transition:var(--transition); font-size:1rem; }
    .accordion-body { max-height:0; overflow:hidden; transition:max-height 0.4s ease, padding 0.4s ease; background:#fff; }
    .accordion-body.open { max-height:800px; padding:16px 18px; }
    .table-wrapper { overflow-x:auto; border-radius:var(--radius-sm); border:1px solid var(--primary-light); margin-top:0.5rem; }
    table { width:100%; border-collapse:collapse; font-size:0.9rem; min-width:600px; }
    table thead { background:var(--primary); color:#fff; }
    table thead th { padding:12px 14px; text-align:center; font-weight:600; font-size:0.85rem; letter-spacing:0.3px; white-space:nowrap; }
    table tbody td { padding:10px 14px; text-align:center; border-bottom:1px solid var(--primary-light); color:var(--text); }
    table tbody tr { transition:var(--transition); }
    table tbody tr:hover { background:#fdf6fc; }
    table tbody tr:nth-child(even) { background:#fefafe; }
    .highlight-box { background:linear-gradient(135deg, #fef3f7 0%, #fdf0f8 100%); border-left:5px solid var(--primary-soft); border-radius:var(--radius-sm); padding:16px 20px; margin:14px 0; font-weight:500; color:#7a3b52; font-size:0.95rem; }
  </style>
</head>
<body>
<div class="app-shell">
  <div class="app-header">
    <div class="logo"><i class="fas fa-seedling"></i><h1>BungaTracker</h1></div>
    <div class="kkm-badge"><i class="fas fa-check-circle"></i> KKM Aligned</div>
  </div>
  <div class="main-nav" id="mainNav">
    <button class="main-tab-btn active" data-tab="dashboard"><i class="fas fa-heart"></i> Dashboard</button>
    <button class="main-tab-btn" data-tab="growth"><i class="fas fa-chart-line"></i> Tumbesaran</button>
    <button class="main-tab-btn" data-tab="baby"><i class="fas fa-baby"></i> Bayi</button>
    <button class="main-tab-btn" data-tab="kkm"><i class="fas fa-syringe"></i> KKM</button>
    <button class="main-tab-btn" data-tab="pantang"><i class="fas fa-utensils"></i> Menu</button>
    <button class="main-tab-btn" data-tab="lists"><i class="fas fa-list-check"></i> Senarai</button>
  </div>

  <!-- Dashboard View -->
  <div class="view-container active" id="viewDashboard">
    <div class="card countdown-card" id="countdownCard"></div>
    <div class="dual-progress" id="progressRings"></div>
    <div class="card" style="text-align:center;">
      <label style="font-size:0.78rem;font-weight:600;color:#9b7b87;"><i class="far fa-calendar-alt"></i> Tarikh Haid Terakhir (LMP)</label>
      <input type="date" id="lmpInput" class="date-input" aria-label="LMP">
      <label style="font-size:0.78rem;font-weight:600;color:#9b7b87;margin-top:0.4rem;"><i class="fas fa-baby"></i> Tarikh Jangkaan Bersalin (EDD)</label>
      <input type="date" id="eddInput" class="date-input" aria-label="EDD">
      <label style="font-size:0.78rem;font-weight:600;color:#9b7b87;margin-top:0.4rem;"><i class="fas fa-baby-carriage"></i> Tarikh Lahir Sebenar (jika sudah)</label>
      <input type="date" id="birthInput" class="date-input" aria-label="Tarikh Lahir">
      <div class="btn-row"><button class="btn" id="updateDatesBtn"><i class="fas fa-sync-alt"></i> Kemaskini</button></div>
      <p style="font-size:0.65rem;margin-top:0.3rem;color:#b2939f;">⚬ KKM sarankan buka buku pink sebelum 12 minggu ⚬</p>
    </div>
    <div id="kickWrapper" style="display:none;"></div>
    <div id="contractionWrapper"></div>
    <div id="breastfeedingWrapper" style="display:none;"></div>
    <div class="card" id="apptCard"></div>
  </div>

  <!-- Tumbesaran View -->
  <div class="view-container" id="viewGrowth">
    <div class="card">
      <h3>📅 Trimester Kehamilan</h3>
      <div class="timeline" style="display:flex; gap:10px; flex-wrap:wrap; background:transparent; border:none;">
        <div class="stat-card" style="border-color:var(--primary-soft);"><span>🌱</span><strong>Trimester 1</strong><br><small>Minggu 1–13</small></div>
        <div class="stat-card"><span>🍊</span><strong>Trimester 2</strong><br><small>Minggu 14–26</small></div>
        <div class="stat-card"><span>🎃</span><strong>Trimester 3</strong><br><small>Minggu 27–40</small></div>
      </div>
    </div>
    <div class="card">
      <h3>🔍 Pilih Minggu Kehamilan</h3>
      <div class="growth-week-selector">
        <button id="growthPrevBtn">◀ Sebelum</button>
        <input type="range" id="growthWeekSlider" min="4" max="40" value="12" step="1">
        <span class="week-display" id="growthWeekDisplay">Minggu 12</span>
        <button id="growthNextBtn">Seterusnya ▶</button>
