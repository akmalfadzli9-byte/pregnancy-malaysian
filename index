  function renderKickCalendar() {
    const calDiv = document.getElementById('kickCal'); if(!calDiv) return;
    const today = DateUtils.today(); const year = today.getFullYear(), month = today.getMonth();
    const firstDay = new Date(year,month,1).getDay(); const daysInMonth = new Date(year,month+1,0).getDate();
    const months = ["Jan","Feb","Mac","Apr","Mei","Jun","Jul","Ogos","Sep","Okt","Nov","Dis"];
    let html = `<div class="cal-nav"><span>${months[month]} ${year}</span></div><div class="cal-grid">`;
    ['Ahd','Isn','Sel','Rab','Kha','Jum','Sab'].forEach(d=>html+=`<div class="cal-day-name">${d}</div>`);
    for(let i=0;i<firstDay;i++) html+='<div class="cal-cell"></div>';
    const kickStart = DateUtils.addDays(currentEDD, -(40-CONST.KICK_START)*7);
    const kickData = Storage.get('kickData')||{};
    const todayStr = DateUtils.fmt(today), dueStr = DateUtils.fmt(currentEDD);
    for(let d=1; d<=daysInMonth; d++){
      const date = new Date(year,month,d);
      const ds = DateUtils.fmt(date);
      const isToday = ds===todayStr;
      const inRange = date>=kickStart && ds<=dueStr;
      let dot='';
      if(inRange){
        const entry = kickData[ds];
        if(entry && entry.count===CONST.KICK_TARGET) dot='complete';
        else if(entry && entry.count>0) dot='partial';
        else dot='missed';
      }
      html+=`<div class="cal-cell${isToday?' today':''}">${d}${inRange?`<span class="kick-dot ${dot}"></span>`:''}</div>`;
    }
    html+='</div>'; calDiv.innerHTML = html;
  }

